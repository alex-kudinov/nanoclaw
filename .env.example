
# ── Claude Auth ──────────────────────────────────────────────────────────────
# Use one: OAuth token (from `claude /login`) or API key
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Key pool (optional — round-robin across up to 5 keys)
# CLAUDE_CODE_OAUTH_TOKEN_1=
# CLAUDE_CODE_OAUTH_TOKEN_2=
# ANTHROPIC_API_KEY_1=
# ANTHROPIC_API_KEY_2=

# ── Slack ─────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ONLY=true

# ── Assistant Identity ────────────────────────────────────────────────────────
ASSISTANT_NAME=Andy

# ── Webhook Server ────────────────────────────────────────────────────────────
WEBHOOK_PORT=8088
WEBHOOK_SECRET=change-me
# Separate public-ingress secret presented by Gravity Forms to n8n. This must
# not be reused for NanoClaw, Plutio, or any other integration.
CNPC_GF_WEBHOOK_SECRET=generate-a-different-random-secret-at-least-32-characters
# Private n8n-to-NanoClaw secret. Store it in an n8n credential, never in
# Gravity Forms or a workflow literal.
CNPC_INTAKE_WEBHOOK_SECRET=generate-a-random-secret-at-least-32-characters

# Community-only student lifecycle relay. Defaults off. The path is a
# capability value configured only in Heartbeat/n8n runtime; do not commit the
# live path or secret. Circle has no setting and remains separately gated.
STUDENT_LIFECYCLE_ENABLED=false
STUDENT_LIFECYCLE_WEBHOOK_PATH=
STUDENT_LIFECYCLE_RELAY_SECRET=
# Host-only; never configure this in n8n. It remains stable across relay-secret
# rotation so durable identity fingerprints do not change.
STUDENT_LIFECYCLE_IDENTITY_SECRET=

# Provider-neutral Party Relationship Context. Defaults off. Source/schema
# presence grants no minion access; every query additionally requires one
# exact host-minted run/container/work/subject/purpose/section grant.
RELATIONSHIP_CONTEXT_ENABLED=0

# Shadow-only checkout recovery relay. Website events use this private opaque
# host path after n8n verifies a separate WordPress ingress secret. Stripe
# failure/expiry facts reuse the authenticated fixed-account Stripe ingress.
# Enabling grants no customer-send, Encharge, CRM, booking, or agent authority.
CHECKOUT_RECOVERY_ENABLED=false
CHECKOUT_RECOVERY_WEBHOOK_PATH=
CHECKOUT_RECOVERY_RELAY_SECRET=
# Host-only HMAC key for stable email digests; never configure in WordPress/n8n
# and never reuse the relay or WordPress ingress secret.
CHECKOUT_RECOVERY_IDENTITY_SECRET=
# Customer delivery is separately gated. Keep off until migration 136, the
# deactivated Encharge flow, exact activation cutoff, and canary are verified.
CHECKOUT_RECOVERY_SEND_MODE=off
CHECKOUT_RECOVERY_SEND_ACTIVATED_AT=
CHECKOUT_RECOVERY_PILOT_EMAIL_SHA256=
# Pilot-only touch-two delay (1-60 minutes) for the allowlisted received-email canary.
# Production ignores this value and always uses the normal 24h/20h timing rule.
CHECKOUT_RECOVERY_PILOT_TOUCH2_DELAY_MINUTES=
ENCHARGE_WRITE_KEY=

# Separate host-only Plutio credential namespace for the CNPC workspace.
# Do not reuse the Tandem Plutio credentials and never mount these into a minion.
CNPC_PLUTIO_API_CLIENTID=
CNPC_PLUTIO_API_CLIENTSECRET=
CNPC_PLUTIO_SUBDOMAIN=

# Durable Stripe -> Chaos lifecycle delivery. Keep disabled until migration 117
# is applied and the authenticated endpoint is verified.
CHAOS_LIFECYCLE_ENABLED=false
CHAOS_LIFECYCLE_URL=https://tandemcoach.co/wp-json/chaos/v1/lifecycle-event
CHAOS_WEBHOOK_SECRET=
CHAOS_COHORT_URL=https://tandemcoach.co/wp-json/chaos/v1/lead/cohorts
CHAOS_EXPORT_API_TOKEN=
# Set to the exact UTC activation time; reconciliation never compares provider
# history from before the new producer was capable of emitting receipts.
CHAOS_LIFECYCLE_COVERAGE_START=

# Host-only Company OS approved-email observer. Defaults off and cannot send,
# retry, approve, or block email. Enabling requires an explicit UTC lower bound
# so a restart cannot silently create an unbounded historical backfill.
COMPANY_WORK_SHADOW_ENABLED=0
COMPANY_WORK_SHADOW_SINCE=
COMPANY_WORK_SHADOW_INTERVAL_MS=60000
COMPANY_WORK_SHADOW_BATCH_LIMIT=100

# Host-owned Company OS exception attention loop. Defaults off. When enabled,
# exact Slack user IDs are required; acknowledgment never changes workflow/job/
# email state and resolution remains source-derived from a complete report.
COMPANY_WORK_EXCEPTION_BRIEF_ENABLED=0
COMPANY_WORK_EXCEPTION_OPERATOR_UIDS=
COMPANY_WORK_EXCEPTION_BRIEF_INTERVAL_MS=86400000
COMPANY_WORK_EXCEPTION_REPORT_LIMIT=100
COMPANY_WORK_EXCEPTION_STALE_AFTER_HOURS=24

# Host-owned outcome-quality review packet. Defaults off. Enabling requires
# exact named Slack UIDs; one private packet is posted per run, and only an
# exact packet reaction records a quality receipt. It never searches Gmail,
# sends customer email, remediates, or changes Company Work state.
COMPANY_WORK_OUTCOME_REVIEW_ENABLED=0
COMPANY_WORK_OUTCOME_REVIEW_OPERATOR_UIDS=
COMPANY_WORK_OUTCOME_REVIEW_INTERVAL_MS=86400000
COMPANY_WORK_OUTCOME_REVIEW_WINDOW_DAYS=30
COMPANY_WORK_OUTCOME_REVIEW_CANDIDATE_LIMIT=25

# Program-facts detector pickup. `off` preserves the legacy notify-only job.
# `active` requires migration 125 and turns each drift run into one durable,
# Chief-routed Company Work exception. It never edits a fact or knowledge file.
PROGRAM_FACTS_COMPANY_WORK_MODE=off

# Bounded host-only healer resolution projection. Defaults off. When enabled,
# exactly one natural healer source key and a hard maximum of one are required;
# projection grants no remediation, Slack, or action authority.
COMPANY_HEALER_WORK_ENABLED=0
COMPANY_HEALER_WORK_SOURCE_KEYS=
COMPANY_HEALER_WORK_MAX_ITEMS=1

# Default-off Company OS observation of one exact scheduled-task boundary.
# Recording grants no task, agent, message, approval, or action authority.
COMPANY_TIME_TRIGGER_ENABLED=0
COMPANY_TIME_TRIGGER_TASK_ID=
COMPANY_TIME_TRIGGER_SCHEDULED_FOR=

# Inbound Gmail cursor bridge. The default `freeze_only` never skips an
# expired history window but does not write the Company OS watermark. Promote
# to `active` only after the exact SQLite/PostgreSQL cursor-alignment gate.
COMPANY_GMAIL_RUNTIME_WATERMARK_MODE=freeze_only

# Host-owned Company OS action control. All values default off so adding this
# release does not alter live behavior. Invalid values fail closed. Do not set
# ACTION_SAFETY_ENFORCEMENT_ENABLED=1 until every intended caller supplies a
# verified action envelope; legacy external-write calls are denied in that mode.
ACTION_SAFETY_ENFORCEMENT_ENABLED=0
EXTERNAL_WRITE_SAFE_MODE=0
# Comma-separated: gmail,slack,courses_smtp,plutio,stripe,hive_firestore,things
EXTERNAL_WRITE_DISABLED_SYSTEMS=

# Per-agent launch/MCP/host-operation projection. Defaults off for compatibility.
# Invalid values and missing/invalid manifests fail closed. Enabling requires a
# separately authorized drain/recycle and group-by-group live canary.
CAPABILITY_MANIFEST_ENFORCEMENT_ENABLED=0
# Comma-separated tracked group folders for a staged rollout while the global
# flag remains off. Unknown, malformed, duplicate, or unregistered groups make
# production startup fail closed.
CAPABILITY_MANIFEST_ENFORCED_GROUPS=

# ── Container Runtime ─────────────────────────────────────────────────────────
# Apple Container: 192.168.64.1 (default)
# Docker Desktop:  host.docker.internal
CONTAINER_HOST_IP=192.168.64.1
CONTAINER_IMAGE=nanoclaw-agent:latest
CONTAINER_TIMEOUT=1800000
IDLE_TIMEOUT=1800000
MAX_CONCURRENT_CONTAINERS=5

# ── Release integrity (production service values) ────────────────────────────
# Production must set all three from the exact reviewed release. Development
# runs normally leave them unset.
# NANOCLAW_REQUIRE_RELEASE_MANIFEST=1
# NANOCLAW_EXPECTED_RELEASE_COMMIT=<full-40-character-commit>
# NANOCLAW_CODE_ROOT=<immutable-extracted-release-directory>

# ── Host attachment extraction (optional command overrides) ──────────────────
# Missing tools produce durable held/review receipts rather than silent success.
# NANOCLAW_MARKITDOWN_BIN=/absolute/path/to/markitdown
# NANOCLAW_TESSERACT_BIN=/absolute/path/to/tesseract
# NANOCLAW_PDFTOPPM_BIN=/absolute/path/to/pdftoppm
# NANOCLAW_PDFTOTEXT_BIN=/absolute/path/to/pdftotext

# ── Token Proxy ───────────────────────────────────────────────────────────────
PROXY_PORT=40960

# ── Infrastructure Reference (not used by code — preserved for ops) ──────────
# MAC_MINI_HOST=
# MAC_MINI_USER=
# MAC_MINI_SSH_KEY=
# VPS_HOST=
# VPS_PORT=
# VPS_USER=
# VPS_SSH_KEY=
# N8N_URL=
