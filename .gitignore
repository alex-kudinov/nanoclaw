# Dependencies
node_modules/
.npm-cache/
# Build output
dist/
.release/

# Local data & auth
store/
data/
!/data/
/data/*
!/data/business/
/data/business/*
!/data/business/CLAUDE.md
!/data/business/migrations/
/data/business/migrations/*
!/data/business/migrations/nanoclaw-v2/
/data/business/migrations/nanoclaw-v2/*
!/data/business/migrations/nanoclaw-v2/*.sql
!/data/business/migrations/nanoclaw-v2/*.sh
!/data/business/migrations/nanoclaw-v2/README.md
logs/

# Groups - track operating instructions, but not conversations/auth/runtime state
groups/*
!groups/*/
groups/*/*
!groups/certifier/EXECUTION-STEPS.md
!groups/certifier/workflows/
!groups/certifier/workflows/*.md
!groups/*/CLAUDE.md
!groups/*/CLAUDE-MAIN.md
!groups/booking/EXECUTION-STEPS.md
!groups/*/WORKFLOWS.md
!groups/*/VOICE-AND-TONE.md
!groups/*/EMAIL-RESPONSE-GUIDELINES.md
!groups/chief/SUPPORT-REPLY.md
!groups/mailman/OUTBOUND-EMAIL.md
!groups/*/SCHEMA.md

# Knowledge directory — track structure and source files, not agent copies or large generated files
knowledge/agents/*/llms-full.txt
knowledge/shared/llms-full.txt
knowledge/agents/*/SCHEDULE.md
knowledge/shared/SCHEDULE.md

# Secrets
*.keys.json
.env

# Python
__pycache__/
*.pyc

# Temp files
.tmp-*
.syncthing.*.tmp

# OS
.DS_Store

# IDE
.idea/
.vscode/

# Skills system (local per-installation state)
.nanoclaw/
.toolbox/

# Session handoffs (local JSONL transcripts — synced via Syncthing)
handoffs/

# Syncthing conflict files
*.sync-conflict-*
.mcp.sync-conflict-*
CLAUDE.sync-conflict-*
.claude/settings.local.sync-conflict-*

agents-sdk-docs
# Build cache
tsconfig.tsbuildinfo

# Env backups (rotation artifacts)
.env.bak*

# Knowledge backups (regen artifacts)
knowledge/shared/KNOWLEDGE.md.bak

# Scratch query files
_query-*.mjs

# Build-artifact & sync backups (never commit)
dist.wip-bak-*/
.stignore.bak

# Operational backups — binary dumps / may contain secrets (sanitize before any commit)
setup/vps/*.dump
setup/vps/n8n-*-backup-*.json
