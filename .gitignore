# Dependencies
node_modules/
.npm-cache/
# Build output
dist/

# Local data & auth
store/
data/
logs/

# Groups - only track base structure and specific CLAUDE.md files
groups/*
!groups/*/
groups/*/*
!groups/*/CLAUDE.md

# Knowledge directory — track structure and source files, not agent copies or large generated files
knowledge/agents/*/llms-full.txt
knowledge/shared/llms-full.txt
knowledge/agents/*/SCHEDULE.md
knowledge/shared/SCHEDULE.md

# Secrets
*.keys.json
.env

# Python
__pycache__/
*.pyc

# Temp files
.tmp-*
.syncthing.*.tmp

# OS
.DS_Store

# IDE
.idea/
.vscode/

# Skills system (local per-installation state)
.nanoclaw/
.toolbox/

# Session handoffs (local JSONL transcripts — synced via Syncthing)
handoffs/

