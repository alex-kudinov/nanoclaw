{
  "version": 1,
  "agent": {
    "folder": "booking",
    "owner": "Company OS",
    "purpose": "Booking and client scheduling operations"
  },
  "inputs": ["Slack requests", "booking events", "scheduled tasks"],
  "dataDomains": ["booking", "agent knowledge"],
  "credentials": { "families": ["business_db"] },
  "tools": {
    "claude": [
      "Bash",
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "ToolSearch",
      "Skill"
    ],
    "mcp": [
      "send_message",
      "schedule_task",
      "list_tasks",
      "pause_task",
      "resume_task",
      "cancel_task"
    ],
    "hostOperations": [
      "message",
      "schedule_task",
      "pause_task",
      "resume_task",
      "cancel_task",
      "learn_lesson"
    ]
  },
  "mounts": {
    "base": ["group", "global", "session", "ipc", "runner"],
    "additional": [
      { "target": "knowledge", "access": "read_only" },
      { "target": "agent_docs", "access": "read_only" }
    ]
  },
  "network": { "mode": "unrestricted_current", "services": ["internet"] },
  "actions": {
    "classes": ["c1_read", "c2_external_write", "c3_external_communication"],
    "approval": "domain_policy"
  },
  "runtime": {
    "models": ["sonnet", "haiku", "opus"],
    "timeoutMsMax": 1800000,
    "spawnTimeoutMsMax": 900000,
    "idleTimeoutMsMax": 1200000,
    "memoryMbMax": 2048,
    "cpusMax": 2
  },
  "slo": {
    "name": "booking response",
    "target": "One acknowledged and reconciled outcome per booking event"
  }
}
