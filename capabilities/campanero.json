{
  "version": 1,
  "agent": {
    "folder": "campanero",
    "owner": "Company OS",
    "purpose": "Host job scheduler management"
  },
  "inputs": ["Slack requests"],
  "dataDomains": ["host job inventory and status"],
  "credentials": { "families": [] },
  "tools": {
    "claude": [],
    "mcp": ["jobs"],
    "hostOperations": ["jobs_mutate"]
  },
  "mounts": {
    "base": ["group", "global", "session", "ipc", "runner"],
    "additional": [
      { "target": "knowledge", "access": "read_only" },
      { "target": "agent_docs", "access": "read_only" }
    ]
  },
  "network": { "mode": "unrestricted_current", "services": ["internet"] },
  "actions": {
    "classes": ["c1_read", "c2_external_write", "c5_destructive"],
    "approval": "domain_policy"
  },
  "runtime": {
    "models": ["sonnet", "haiku", "opus"],
    "timeoutMsMax": 1800000,
    "spawnTimeoutMsMax": 900000,
    "idleTimeoutMsMax": 1200000,
    "memoryMbMax": 2048,
    "cpusMax": 2
  },
  "slo": {
    "name": "job operation",
    "target": "Every requested job operation is host-validated and receipted"
  }
}
