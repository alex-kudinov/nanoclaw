{
  "version": 1,
  "agent": {
    "folder": "capacity",
    "owner": "Academy operations",
    "purpose": "Bounded Academy capacity inventory and operator commands"
  },
  "inputs": ["Named-human Slack requests", "host readback receipts"],
  "dataDomains": ["Academy capacity", "enrollment read models"],
  "credentials": { "families": [] },
  "tools": {
    "claude": ["Read", "Glob", "Grep", "Skill"],
    "mcp": [
      "capacity_inventory",
      "capacity_enrollment",
      "capacity_reserve_manual",
      "capacity_release_reservation",
      "capacity_transfer_assignment",
      "capacity_withdraw_assignment",
      "capacity_reconcile_pool",
      "capacity_join_waitlist",
      "capacity_stage_waitlist_offer"
    ],
    "hostOperations": [
      "capacity_inventory",
      "capacity_enrollment",
      "reserve_manual",
      "release_reservation",
      "transfer_assignment",
      "withdraw_assignment",
      "reconcile_pool",
      "join_waitlist",
      "stage_waitlist_offer"
    ]
  },
  "mounts": {
    "base": ["group", "global", "session", "ipc", "runner"],
    "additional": []
  },
  "network": { "mode": "none", "services": [] },
  "actions": {
    "classes": ["c1_read", "c2_external_write"],
    "approval": "named_human"
  },
  "runtime": {
    "models": ["sonnet", "haiku"],
    "timeoutMsMax": 600000,
    "spawnTimeoutMsMax": 600000,
    "idleTimeoutMsMax": 600000,
    "memoryMbMax": 1024,
    "cpusMax": 1
  },
  "slo": {
    "name": "capacity command integrity",
    "target": "Every mutation is exact, version-bound, idempotent, and read back"
  }
}
