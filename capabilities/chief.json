{
  "version": 1,
  "agent": {
    "folder": "chief",
    "owner": "Company OS",
    "purpose": "Cross-agent coordination and exception handling"
  },
  "inputs": ["Slack requests", "agent escalations", "scheduled tasks"],
  "dataDomains": ["operations", "email read models", "agent knowledge"],
  "tools": {
    "claude": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Task",
      "TaskOutput",
      "TaskStop",
      "TeamCreate",
      "TeamDelete",
      "SendMessage",
      "TodoWrite",
      "ToolSearch",
      "Skill"
    ],
    "mcp": [
      "send_message",
      "send_grader_file",
      "schedule_task",
      "list_tasks",
      "pause_task",
      "resume_task",
      "cancel_task",
      "gmail_read",
      "jobs"
    ],
    "hostOperations": [
      "message",
      "slack_file_message",
      "schedule_task",
      "pause_task",
      "resume_task",
      "cancel_task",
      "gmail_read",
      "jobs_mutate",
      "learn_lesson",
      "route_lesson"
    ]
  },
  "mounts": {
    "base": ["group", "global", "session", "ipc", "runner"],
    "additional": [{ "target": "knowledge", "access": "read_only" }]
  },
  "network": { "mode": "unrestricted_current", "services": ["internet"] },
  "actions": {
    "classes": [
      "c1_read",
      "c2_external_write",
      "c3_external_communication",
      "c5_destructive"
    ],
    "approval": "named_human"
  },
  "runtime": {
    "models": ["sonnet", "haiku", "opus"],
    "timeoutMsMax": 1800000,
    "spawnTimeoutMsMax": 900000,
    "idleTimeoutMsMax": 1200000,
    "memoryMbMax": 2048,
    "cpusMax": 2
  },
  "slo": {
    "name": "exception resolution",
    "target": "Bounded handoff with owner and evidence"
  }
}
