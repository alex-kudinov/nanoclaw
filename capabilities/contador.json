{
  "version": 1,
  "agent": {
    "folder": "contador",
    "owner": "Finance operations",
    "purpose": "Financial reconciliation and reporting"
  },
  "inputs": ["Slack requests", "scheduled tasks", "payment records"],
  "dataDomains": [
    "finance",
    "email read models",
    "service accounts",
    "agent knowledge"
  ],
  "tools": {
    "claude": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "ToolSearch",
      "Skill"
    ],
    "mcp": [
      "send_message",
      "schedule_task",
      "list_tasks",
      "pause_task",
      "resume_task",
      "cancel_task",
      "gmail_read"
    ],
    "hostOperations": [
      "message",
      "schedule_task",
      "pause_task",
      "resume_task",
      "cancel_task",
      "gmail_read",
      "learn_lesson"
    ]
  },
  "mounts": {
    "base": ["group", "global", "session", "ipc", "runner"],
    "additional": [
      { "target": "tools", "access": "read_only" },
      { "target": "credentials", "access": "read_only" },
      { "target": "knowledge", "access": "read_only" }
    ]
  },
  "network": { "mode": "unrestricted_current", "services": ["internet"] },
  "actions": {
    "classes": [
      "c1_read",
      "c2_external_write",
      "c3_external_communication",
      "c4_financial"
    ],
    "approval": "named_human"
  },
  "runtime": {
    "models": ["sonnet", "haiku", "opus"],
    "timeoutMsMax": 1800000,
    "spawnTimeoutMsMax": 900000,
    "idleTimeoutMsMax": 1200000,
    "memoryMbMax": 2048,
    "cpusMax": 2
  },
  "slo": {
    "name": "financial reconciliation",
    "target": "Every reported result traces to authoritative records"
  }
}
