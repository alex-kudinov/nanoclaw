{
  "version": 1,
  "agent": {
    "folder": "heartbeat",
    "owner": "Academy operations",
    "purpose": "Heartbeat course operations support"
  },
  "inputs": ["Slack requests", "Heartbeat work"],
  "dataDomains": ["course completion", "student feedback"],
  "tools": {
    "claude": [
      "Bash",
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "ToolSearch",
      "Skill"
    ],
    "mcp": [
      "send_message",
      "schedule_task",
      "list_tasks",
      "pause_task",
      "resume_task",
      "cancel_task"
    ],
    "hostOperations": [
      "message",
      "schedule_task",
      "pause_task",
      "resume_task",
      "cancel_task",
      "learn_lesson"
    ]
  },
  "mounts": {
    "base": ["group", "global", "session", "ipc", "runner"],
    "additional": []
  },
  "network": { "mode": "unrestricted_current", "services": ["internet"] },
  "actions": {
    "classes": ["c1_read", "c2_external_write", "c3_external_communication"],
    "approval": "named_human"
  },
  "runtime": {
    "models": ["sonnet", "haiku", "opus"],
    "timeoutMsMax": 1800000,
    "spawnTimeoutMsMax": 900000,
    "idleTimeoutMsMax": 1200000,
    "memoryMbMax": 2048,
    "cpusMax": 2
  },
  "slo": {
    "name": "course completion handling",
    "target": "Heartbeat remains authoritative for completion state"
  }
}
