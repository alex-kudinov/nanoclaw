{
  "version": 1,
  "agent": {
    "folder": "inbox",
    "owner": "Company OS",
    "purpose": "Operational inbox triage"
  },
  "inputs": ["Slack inbox items", "webhook events"],
  "dataDomains": ["operations inbox", "agent knowledge"],
  "tools": {
    "claude": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "ToolSearch",
      "Skill"
    ],
    "mcp": [
      "send_message",
      "schedule_task",
      "list_tasks",
      "pause_task",
      "resume_task",
      "cancel_task"
    ],
    "hostOperations": [
      "message",
      "schedule_task",
      "pause_task",
      "resume_task",
      "cancel_task",
      "learn_lesson"
    ]
  },
  "mounts": {
    "base": ["group", "global", "session", "ipc", "runner"],
    "additional": [{ "target": "knowledge", "access": "read_only" }]
  },
  "network": { "mode": "unrestricted_current", "services": ["internet"] },
  "actions": {
    "classes": ["c1_read", "c2_external_write", "c3_external_communication"],
    "approval": "domain_policy"
  },
  "runtime": {
    "models": ["sonnet", "haiku", "opus"],
    "timeoutMsMax": 1800000,
    "spawnTimeoutMsMax": 900000,
    "idleTimeoutMsMax": 1200000,
    "memoryMbMax": 2048,
    "cpusMax": 2
  },
  "slo": {
    "name": "inbox triage",
    "target": "Every accepted item has an owner or explicit hold"
  }
}
