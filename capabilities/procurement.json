{
  "version": 1,
  "agent": {
    "folder": "procurement",
    "owner": "Procurement operations",
    "purpose": "Opportunity discovery and guarded pursuit review"
  },
  "inputs": ["Slack requests", "scheduled scans", "public opportunity results"],
  "dataDomains": [
    "procurement",
    "email read models",
    "opportunity records",
    "agent knowledge"
  ],
  "tools": {
    "claude": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "ToolSearch",
      "Skill"
    ],
    "mcp": [
      "send_message",
      "schedule_task",
      "list_tasks",
      "pause_task",
      "resume_task",
      "cancel_task",
      "gmail_read",
      "procurement_queue",
      "procurement_caleprocure_ingest",
      "procurement_pursuit_queue",
      "procurement_review_card"
    ],
    "hostOperations": [
      "message",
      "schedule_task",
      "pause_task",
      "resume_task",
      "cancel_task",
      "gmail_read",
      "procurement_queue",
      "procurement_caleprocure_ingest",
      "procurement_pursuit_queue",
      "procurement_review_card",
      "learn_lesson"
    ]
  },
  "mounts": {
    "base": ["group", "global", "session", "ipc", "runner"],
    "additional": [
      { "target": "knowledge", "access": "read_only" },
      { "target": "vault-procurement", "access": "read_write" },
      { "target": "agent_docs", "access": "read_only" }
    ]
  },
  "network": { "mode": "unrestricted_current", "services": ["internet"] },
  "actions": {
    "classes": ["c1_read", "c2_external_write", "c3_external_communication"],
    "approval": "named_human"
  },
  "runtime": {
    "models": ["sonnet", "haiku", "opus"],
    "timeoutMsMax": 1800000,
    "spawnTimeoutMsMax": 900000,
    "idleTimeoutMsMax": 1200000,
    "memoryMbMax": 2048,
    "cpusMax": 2
  },
  "slo": {
    "name": "opportunity review",
    "target": "Every decision is version-bound and receipt-backed"
  }
}
