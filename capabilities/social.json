{
  "version": 1,
  "agent": {
    "folder": "social",
    "owner": "Marketing operations",
    "purpose": "LinkedIn content preparation and posting support"
  },
  "inputs": ["Slack requests", "scheduled tasks"],
  "dataDomains": ["LinkedIn", "editorial content", "voice assets"],
  "tools": {
    "claude": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "ToolSearch",
      "Skill"
    ],
    "mcp": [
      "send_message",
      "schedule_task",
      "list_tasks",
      "pause_task",
      "resume_task",
      "cancel_task"
    ],
    "hostOperations": [
      "message",
      "schedule_task",
      "pause_task",
      "resume_task",
      "cancel_task",
      "learn_lesson"
    ]
  },
  "mounts": {
    "base": ["group", "global", "session", "ipc", "runner"],
    "additional": [
      { "target": "linkedin", "access": "read_only" },
      { "target": "toolbox-lib", "access": "read_only" },
      { "target": "vault-linkedin", "access": "read_write" },
      { "target": "tandemweb-blog", "access": "read_only" },
      { "target": "alex-voice", "access": "read_only" }
    ]
  },
  "network": { "mode": "unrestricted_current", "services": ["internet"] },
  "actions": {
    "classes": ["c1_read", "c2_external_write", "c3_external_communication"],
    "approval": "named_human"
  },
  "runtime": {
    "models": ["sonnet", "haiku", "opus"],
    "timeoutMsMax": 1800000,
    "spawnTimeoutMsMax": 900000,
    "idleTimeoutMsMax": 1200000,
    "memoryMbMax": 2048,
    "cpusMax": 2
  },
  "slo": {
    "name": "social publication",
    "target": "Publication state and receipt are explicit"
  }
}
