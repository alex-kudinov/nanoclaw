+    // =========================================================================
+    // Checkout recovery shadow helper
+    // =========================================================================
+
+    /**
+     * Send one bounded, signed lifecycle fact to the shadow-only n8n relay.
+     * Fail open: checkout, enrollment, and Stripe webhook acknowledgement never
+     * depend on this observer. The ingress secret remains server-side.
+     */
+    private function fire_checkout_recovery_shadow(
+        string $event_type,
+        string $token,
+        array $session,
+        array $product,
+        string $source_event_key,
+        array $overrides = []
+    ): void {
+        $allowed = [
+            'checkout.captured',
+            'payment.created',
+            'checkout.client_abandoned',
+            'payment.failed',
+            'payment.succeeded',
+        ];
+        if (!in_array($event_type, $allowed, true)) {
+            $this->log('Checkout recovery shadow skipped: unsupported event');
+            return;
+        }
+        if (
+            empty($this->checkout_recovery_url) ||
+            empty($this->checkout_recovery_ingress_secret) ||
+            strlen($this->checkout_recovery_ingress_secret) < 32
+        ) {
+            return;
+        }
+        if (
+            !preg_match('/^[A-Za-z0-9]{32}$/', $token) ||
+            !preg_match('/^[A-Za-z0-9][A-Za-z0-9._:-]{0,499}$/', $source_event_key)
+        ) {
+            $this->log('Checkout recovery shadow skipped: invalid identity');
+            return;
+        }
+        $email = sanitize_email((string) ($session['email'] ?? ''));
+        if (!is_email($email)) {
+            $this->log('Checkout recovery shadow skipped: invalid email');
+            return;
+        }
+        $payload = [
+            'schema_version'         => 1,
+            'source_event_key'       => $source_event_key,
+            'event_type'             => $event_type,
+            'observed_at'            => gmdate('c'),
+            'checkout_token'         => $token,
+            'email'                  => $email,
+            'program_slug'           => sanitize_key((string) ($product['program'] ?? '')),
+            'product_slug'           => sanitize_key((string) ($session['product'] ?? '')),
+            'amount_cents'           => max(0, (int) ($overrides['amount_cents'] ?? ($session['price_cents'] ?? $product['price_cents'] ?? 0))),
+            'currency'               => strtolower(sanitize_key((string) ($product['currency'] ?? 'usd'))),
+            'consent_state'          => !empty($session['recovery_consent']) ? 'granted' : 'denied',
+            'consent_policy_version' => sanitize_key((string) ($session['recovery_consent_policy'] ?? self::RECOVERY_CONSENT_POLICY)),
+        ];
+        foreach (['payment_intent_id', 'checkout_session_id'] as $field) {
+            if (!empty($overrides[$field])) {
+                $payload[$field] = sanitize_text_field((string) $overrides[$field]);
+            }
+        }
+        $body = wp_json_encode($payload);
+        if (!is_string($body) || strlen($body) > 32768) {
+            $this->log('Checkout recovery shadow skipped: invalid payload');
+            return;
+        }
+        if ($this->send_checkout_recovery_shadow_body($body)) {
+            $this->log('Checkout recovery shadow accepted: ' . $event_type);
+            return;
+        }
+        $this->queue_checkout_recovery_shadow_body($source_event_key, $body);
+        $this->log('Checkout recovery shadow queued: ' . $event_type);
+    }
+
+    /** Send one already-normalized body with a fresh short-lived HMAC. */
+    private function send_checkout_recovery_shadow_body(string $body): bool {
+        if (
+            empty($this->checkout_recovery_url) ||
+            empty($this->checkout_recovery_ingress_secret)
+        ) {
+            return false;
+        }
+        $timestamp = (string) time();
+        $signature = hash_hmac(
+            'sha256',
+            $timestamp . '.' . $body,
+            $this->checkout_recovery_ingress_secret
+        );
+        $response = wp_remote_post($this->checkout_recovery_url, [
+            'headers' => [
+                'Content-Type'         => 'application/json',
+                'X-Checkout-Timestamp' => $timestamp,
+                'X-Checkout-Signature' => 'sha256=' . $signature,
+            ],
+            'body'        => $body,
+            'timeout'     => 4,
+            'redirection' => 0,
+        ]);
+        if (is_wp_error($response)) {
+            return false;
+        }
+        $code = wp_remote_retrieve_response_code($response);
+        return $code >= 200 && $code < 300;
+    }
+
+    /** Persist failed shadow delivery for bounded WordPress-cron retry. */
+    private function queue_checkout_recovery_shadow_body(string $event_key, string $body): void {
+        $queue = get_option('tandem_checkout_recovery_shadow_queue', []);
+        if (!is_array($queue)) {
+            $queue = [];
+        }
+        $queue[$event_key] = [
+            'body'         => $body,
+            'attempts'     => (int) ($queue[$event_key]['attempts'] ?? 0),
+            'next_attempt' => time() + 300,
+            'exhausted'    => false,
+        ];
+        update_option('tandem_checkout_recovery_shadow_queue', $queue, false);
+        if (!wp_next_scheduled('tandem_checkout_recovery_retry')) {
+            wp_schedule_single_event(time() + 300, 'tandem_checkout_recovery_retry');
+        }
+    }
+
+    /**
+     * Drain at most 25 queued shadow facts. Exhausted rows remain visible in
+     * the option for operator inspection; they are never silently deleted.
+     */
+    public function drain_checkout_recovery_shadow_queue(): void {
+        $queue = get_option('tandem_checkout_recovery_shadow_queue', []);
+        if (!is_array($queue) || empty($queue)) {
+            return;
+        }
+        $now = time();
+        $processed = 0;
+        foreach ($queue as $event_key => &$item) {
+            if (
+                $processed >= 25 ||
+                !is_array($item) ||
+                !empty($item['exhausted']) ||
+                (int) ($item['next_attempt'] ?? 0) > $now
+            ) {
+                continue;
+            }
+            $processed++;
+            $body = (string) ($item['body'] ?? '');
+            if ($body !== '' && $this->send_checkout_recovery_shadow_body($body)) {
+                unset($queue[$event_key]);
+                continue;
+            }
+            $attempts = (int) ($item['attempts'] ?? 0) + 1;
+            $item['attempts'] = $attempts;
+            if ($attempts >= 10) {
+                $item['exhausted'] = true;
+                $this->log('Checkout recovery shadow retry exhausted: ' . sanitize_text_field((string) $event_key));
+            } else {
+                $delay = min(6 * HOUR_IN_SECONDS, 300 * (2 ** min($attempts, 6)));
+                $item['next_attempt'] = $now + $delay;
+            }
+        }
+        unset($item);
+        update_option('tandem_checkout_recovery_shadow_queue', $queue, false);
+        $remaining = array_filter($queue, static function ($item): bool {
+            return is_array($item) && empty($item['exhausted']);
+        });
+        if (!empty($remaining) && !wp_next_scheduled('tandem_checkout_recovery_retry')) {
+            $next = min(array_map(static function ($item): int {
+                return (int) ($item['next_attempt'] ?? (time() + 300));
+            }, $remaining));
+            wp_schedule_single_event(max(time() + 60, $next), 'tandem_checkout_recovery_retry');
+        }
+    }
