+#!/usr/bin/env bash
+# list-event-destinations -- content-minimized Stripe webhook endpoint inventory.
+set -euo pipefail
+
+show_help() {
+  cat <<'USAGE'
+Usage: list-event-destinations [--account primary|alt|all]
+
+Lists exact endpoint ids, account, status, descriptions, and enabled event
+types. Endpoint URLs and secrets are deliberately omitted.
+USAGE
+}
+
+ACCOUNT="${STRIPE_ACCOUNT:-primary}"
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --help|-h) show_help; exit 0 ;;
+    --account) ACCOUNT="$2"; shift 2 ;;
+    *) echo "unknown arg: $1" >&2; exit 1 ;;
+  esac
+done
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+source "${TOOLBOX_LIB:?TOOLBOX_LIB not set}/response.sh"
+source "${SCRIPT_DIR}/lib/stripe-api.sh"
+stripe_load_env
+case "$ACCOUNT" in primary|alt|all) : ;; *) fail INVALID_ARG "--account must be primary|alt|all"; exit 1 ;; esac
+accounts=("$ACCOUNT")
+[[ "$ACCOUNT" == "all" ]] && accounts=(primary alt)
+combined='[]'
+for acct in "${accounts[@]}"; do
+  key="$(stripe_key_for "$acct" 2>/dev/null || true)"
+  if [[ -z "$key" ]]; then
+    [[ "$ACCOUNT" == "all" ]] && continue
+    fail MISSING_CONFIG "No Stripe key for account '$acct'"; exit 1
+  fi
+  if ! response="$(stripe_api "$acct" GET "/webhook_endpoints" -d 'limit=100' 2>/dev/null)"; then
+    fail API_ERROR "Unable to list Stripe event destinations on account '$acct'"; exit 1
+  fi
+  rows="$(jq -c --arg acct "$acct" '[.data[] | {
+    id, account:$acct, status, description:(.description // ""),
+    enabled_events:([.enabled_events[]] | unique | sort),
+    created, api_version
+  }]' <<<"$response")"
+  combined="$(jq -nc --argjson a "$combined" --argjson b "$rows" '$a + $b')"
+done
+ok_json "$(jq -nc --argjson rows "$combined" '{ok:true,count:($rows|length),event_destinations:$rows}')"
