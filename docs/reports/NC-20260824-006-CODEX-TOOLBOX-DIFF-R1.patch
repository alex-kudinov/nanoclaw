+#!/usr/bin/env bash
+# Narrow Stripe write helper for one exact event-destination event-set update.
+
+stripe_event_destination_update() {
+  local acct="$1" endpoint_id="$2"; shift 2
+  [[ "$endpoint_id" =~ ^we_[A-Za-z0-9_]+$ ]] || {
+    fail INVALID_ARG "invalid Stripe event destination id"; return 1;
+  }
+  local key response http_code body
+  key="$(stripe_key_for "$acct")" || return 1
+  [[ -n "$key" ]] || { fail MISSING_CONFIG "No Stripe key for account '$acct'"; return 1; }
+  response="$(curl -sS -w $'\n%{http_code}' -X POST \
+    "${STRIPE_API_BASE}/webhook_endpoints/${endpoint_id}" \
+    -H "Authorization: Bearer ${key}" "$@")" || {
+      fail API_ERROR "Failed to connect to Stripe event destination"; return 1;
+    }
+  http_code="$(tail -1 <<<"$response")"
+  body="$(sed '$d' <<<"$response")"
+  if [[ "$http_code" == "200" ]]; then printf '%s' "$body"; return 0; fi
+  fail API_ERROR "Stripe event destination update failed (HTTP ${http_code})"
+  return 1
+}
