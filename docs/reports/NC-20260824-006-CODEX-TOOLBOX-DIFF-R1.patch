+#!/usr/bin/env bash
+set -euo pipefail
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+REGISTRY="$ROOT/registry.json"
+LIST="$ROOT/tools/stripe/list-checkout-sessions.sh"
+ENSURE="$ROOT/tools/stripe/ensure-checkout-recovery-events.sh"
+DESTINATIONS="$ROOT/tools/stripe/list-event-destinations.sh"
+LIB="$ROOT/lib/stripe-api.sh"
+
+jq -e '.categories.stripe.tools["list-checkout-sessions"]' "$REGISTRY" >/dev/null
+jq -e '.categories.stripe.tools["ensure-checkout-recovery-events"]' "$REGISTRY" >/dev/null
+jq -e '.categories.stripe.tools["list-event-destinations"]' "$REGISTRY" >/dev/null
+"$LIST" --help | grep -q 'Never returns customer email, recovery URLs'
+"$ENSURE" --help | grep -q 'additive-only'
+"$DESTINATIONS" --help | grep -q 'Endpoint URLs and secrets are deliberately omitted'
+! grep -q 'url:' "$DESTINATIONS"
+
+grep -q "payment_intent.payment_failed" "$ENSURE"
+grep -q "checkout.session.expired" "$ENSURE"
+grep -q 'original + $required | unique | sort' "$ENSURE"
+grep -q 'readback' "$ENSURE"
+! grep -Eq 'DELETE|/expire|enabled_events\[\].*charge.refunded' "$ENSURE"
+
+grep -q 'customer_email_present' "$LIST"
+grep -q 'recovery_url_present' "$LIST"
+! grep -q "customer_email:" "$LIST"
+! grep -q "recovery_url:" "$LIST"
+grep -q 'STRIPE_SECRET_KEY_ALT' "$LIB"
+! grep -q 'source "$env_file"' "$LIB"
+
+echo "PASS stripe checkout recovery toolbox contracts"
