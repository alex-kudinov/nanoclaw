+#!/usr/bin/env bash
+# list-checkout-sessions -- content-minimized Checkout Session reconciliation.
+set -euo pipefail
+
+show_help() {
+  cat <<'USAGE'
+Usage: list-checkout-sessions [--account primary|alt|all]
+  [--status open|complete|expired|all] [--created-gte UNIX]
+  [--created-lte UNIX] [--max-results N]
+
+Lists Stripe Checkout Sessions without returning customer email, recovery URLs,
+or raw metadata. Results include exact provider ids, account, status, amount,
+product/price ids, recovery flags, and consent state for reconciliation.
+
+Args:
+  --account      primary | alt | all (default primary)
+  --status       open | complete | expired | all (default expired)
+  --created-gte  Inclusive Unix timestamp
+  --created-lte  Inclusive Unix timestamp
+  --max-results  Cap across accounts, 1-500 (default 100)
+USAGE
+}
+
+ACCOUNT="${STRIPE_ACCOUNT:-primary}"
+STATUS="expired"
+CREATED_GTE=""
+CREATED_LTE=""
+MAX_RESULTS=100
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --help|-h) show_help; exit 0 ;;
+    --account) ACCOUNT="$2"; shift 2 ;;
+    --status) STATUS="$2"; shift 2 ;;
+    --created-gte) CREATED_GTE="$2"; shift 2 ;;
+    --created-lte) CREATED_LTE="$2"; shift 2 ;;
+    --max-results) MAX_RESULTS="$2"; shift 2 ;;
+    *) echo "unknown arg: $1" >&2; exit 1 ;;
+  esac
+done
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+source "${TOOLBOX_LIB:?TOOLBOX_LIB not set}/response.sh"
+source "${SCRIPT_DIR}/lib/stripe-api.sh"
+stripe_load_env
+
+case "$ACCOUNT" in primary|alt|all) : ;; *) fail INVALID_ARG "--account must be primary|alt|all"; exit 1 ;; esac
+case "$STATUS" in open|complete|expired|all) : ;; *) fail INVALID_ARG "--status must be open|complete|expired|all"; exit 1 ;; esac
+[[ "$MAX_RESULTS" =~ ^[0-9]+$ ]] && (( MAX_RESULTS >= 1 && MAX_RESULTS <= 500 )) || {
+  fail INVALID_ARG "--max-results must be 1-500"; exit 1;
+}
+for value in "$CREATED_GTE" "$CREATED_LTE"; do
+  [[ -z "$value" || "$value" =~ ^[0-9]{9,12}$ ]] || {
+    fail INVALID_ARG "created bounds must be Unix timestamps"; exit 1;
+  }
+done
+if [[ -n "$CREATED_GTE" && -n "$CREATED_LTE" ]] && (( CREATED_GTE > CREATED_LTE )); then
+  fail INVALID_ARG "--created-gte must not exceed --created-lte"; exit 1
+fi
+
+accounts=("$ACCOUNT")
+[[ "$ACCOUNT" == "all" ]] && accounts=(primary alt)
+combined='[]'
+truncated=false
+for acct in "${accounts[@]}"; do
+  key="$(stripe_key_for "$acct" 2>/dev/null || true)"
+  if [[ -z "$key" ]]; then
+    [[ "$ACCOUNT" == "all" ]] && continue
+    fail MISSING_CONFIG "No Stripe key for account '$acct'"; exit 1
+  fi
+  remaining=$((MAX_RESULTS - $(jq 'length' <<<"$combined")))
+  (( remaining > 0 )) || { truncated=true; break; }
+  page_limit=$remaining
+  (( page_limit > 100 )) && page_limit=100
+  args=(-d "limit=${page_limit}" -d "expand[]=data.line_items")
+  [[ "$STATUS" != "all" ]] && args+=(-d "status=${STATUS}")
+  [[ -n "$CREATED_GTE" ]] && args+=(-d "created[gte]=${CREATED_GTE}")
+  [[ -n "$CREATED_LTE" ]] && args+=(-d "created[lte]=${CREATED_LTE}")
+  response="$(stripe_api "$acct" GET "/checkout/sessions" "${args[@]}")" || exit 1
+  rows="$(jq -c --arg acct "$acct" '[.data[] | {
+    id, account:$acct, status, payment_status, mode, amount_total, currency,
+    created, expires_at, payment_intent_id:.payment_intent,
+    subscription_id:.subscription, recovered_from,
+    recovery_enabled:(.after_expiration.recovery.enabled // false),
+    recovery_url_present:((.after_expiration.recovery.url // "") != ""),
+    recovery_expires_at:(.after_expiration.recovery.expires_at // null),
+    promotions_consent:(.consent.promotions // "unknown"),
+    customer_email_present:(((.customer_details.email // .customer_email // "") != "")),
+    product_ids:([.line_items.data[]?.price.product] | map(select(. != null)) | unique | sort),
+    price_ids:([.line_items.data[]?.price.id] | map(select(. != null)) | unique | sort)
+  }]' <<<"$response")" || { fail PARSE_ERROR "Could not parse Stripe Checkout Sessions"; exit 1; }
+  combined="$(jq -nc --argjson a "$combined" --argjson b "$rows" '$a + $b')"
+  has_more="$(jq -r '.has_more // false' <<<"$response")"
+  [[ "$has_more" == "true" ]] && truncated=true
+done
+
+result="$(jq -nc --argjson rows "$combined" --argjson truncated "$truncated" '{ok:true,count:($rows|length),truncated:$truncated,sessions:$rows}')"
+ok_json "$result"
