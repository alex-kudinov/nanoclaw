@@ -0,0 +1,69 @@
+#!/usr/bin/env bash
+# ensure-checkout-recovery-events -- additive-only Stripe event reconciliation.
+set -euo pipefail
+
+show_help() {
+  cat <<'USAGE'
+Usage: ensure-checkout-recovery-events --id we_... [--account primary|alt]
+  [--confirm yes]
+
+Reads one exact Stripe event destination and prepares an additive-only change
+that preserves every existing enabled event and adds only:
+  payment_intent.payment_failed
+  checkout.session.expired
+
+Without --confirm yes this is a dry run. Confirmed updates are read back and
+fail unless all original and required events remain enabled.
+USAGE
+}
+
+ID="" ACCOUNT="${STRIPE_ACCOUNT:-primary}" CONFIRM="no"
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --help|-h) show_help; exit 0 ;;
+    --id) ID="$2"; shift 2 ;;
+    --account) ACCOUNT="$2"; shift 2 ;;
+    --confirm) CONFIRM="$2"; shift 2 ;;
+    *) echo "unknown arg: $1" >&2; exit 1 ;;
+  esac
+done
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+source "${TOOLBOX_LIB:?TOOLBOX_LIB not set}/response.sh"
+source "${SCRIPT_DIR}/lib/stripe-api.sh"
+source "${SCRIPT_DIR}/lib/stripe-event-destination-write.sh"
+stripe_load_env
+
+[[ "$ID" =~ ^we_[A-Za-z0-9_]+$ ]] || { fail INVALID_ARG "--id must be a Stripe we_ event destination"; exit 1; }
+case "$ACCOUNT" in primary|alt) : ;; *) fail INVALID_ARG "--account must be primary|alt"; exit 1 ;; esac
+case "$CONFIRM" in yes|no) : ;; *) fail INVALID_ARG "--confirm must be yes|no"; exit 1 ;; esac
+
+if ! current="$(stripe_api "$ACCOUNT" GET "/webhook_endpoints/${ID}" 2>/dev/null)"; then
+  fail API_ERROR "Unable to read the exact Stripe event destination on account '$ACCOUNT'"
+  exit 1
+fi
+status="$(jq -r '.status // empty' <<<"$current")"
+[[ "$status" == "enabled" ]] || { fail CONFLICT "Stripe event destination is not enabled"; exit 1; }
+original="$(jq -c '[.enabled_events[]] | unique | sort' <<<"$current")"
+required='["checkout.session.expired","payment_intent.payment_failed"]'
+desired="$(jq -nc --argjson original "$original" --argjson required "$required" '$original + $required | unique | sort')"
+
+if [[ "$original" == "$desired" ]]; then
+  ok_json "$(jq -nc --arg id "$ID" --arg account "$ACCOUNT" --argjson events "$original" '{ok:true,changed:false,id:$id,account:$account,enabled_events:$events,verified:true}')"
+  exit 0
+fi
+if [[ "$CONFIRM" != "yes" ]]; then
+  ok_json "$(jq -nc --arg id "$ID" --arg account "$ACCOUNT" --argjson before "$original" --argjson after "$desired" '{ok:true,dry_run:true,changed:true,id:$id,account:$account,before:$before,after:$after}')"
+  exit 0
+fi
+
+args=()
+while IFS= read -r event; do args+=(--data-urlencode "enabled_events[]=${event}"); done < <(jq -r '.[]' <<<"$desired")
+stripe_event_destination_update "$ACCOUNT" "$ID" "${args[@]}" >/dev/null || exit 1
+if ! readback="$(stripe_api "$ACCOUNT" GET "/webhook_endpoints/${ID}" 2>/dev/null)"; then
+  fail API_ERROR "Stripe update returned but readback failed"
+  exit 1
+fi
+actual="$(jq -c '[.enabled_events[]] | unique | sort' <<<"$readback")"
+[[ "$actual" == "$desired" ]] || { fail CONFLICT "Stripe readback did not match additive event set"; exit 1; }
+ok_json "$(jq -nc --arg id "$ID" --arg account "$ACCOUNT" --argjson before "$original" --argjson after "$actual" '{ok:true,changed:true,id:$id,account:$account,before:$before,enabled_events:$after,verified:true}')"
