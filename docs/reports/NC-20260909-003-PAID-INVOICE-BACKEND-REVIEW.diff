+    if (this.timer) return;
+    this.timer = setInterval(
+      () => void this.sweep(),
+      this.config.retentionPolicy.sweepIntervalMs,
+    );
+    this.timer.unref();
+  }
+
+  stop(): void {
+    if (this.timer) clearInterval(this.timer);
+    this.timer = null;
+  }
 }
