{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "academy-capacity-source-resolution-v1.schema.json",
  "title": "Academy capacity source resolution evidence",
  "type": "object",
  "required": [
    "schema_version",
    "resolution_id",
    "task_id",
    "observed_at",
    "resolves",
    "privacy",
    "owner_decisions",
    "source_readback",
    "capacity",
    "offer_and_funding",
    "resolved_exceptions",
    "remaining_exceptions",
    "boundary"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "resolution_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]+$" },
    "task_id": { "const": "NC-20260906-001" },
    "observed_at": { "type": "string", "format": "date-time" },
    "resolves": { "type": "object" },
    "privacy": { "type": "object" },
    "owner_decisions": { "type": "object" },
    "source_readback": { "type": "object" },
    "capacity": { "type": "object" },
    "offer_and_funding": { "type": "object" },
    "resolved_exceptions": { "type": "array", "minItems": 5 },
    "remaining_exceptions": { "type": "array", "minItems": 1 },
    "boundary": { "type": "object" }
  },
  "additionalProperties": false
}
