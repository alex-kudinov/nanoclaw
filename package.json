{
  "name": "nanoclaw",
  "version": "1.2.1",
  "description": "Personal Claude assistant. Lightweight, secure, customizable.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "NODE_ENV=production NANOCLAW_REQUIRE_RELEASE_MANIFEST=1 node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "capabilities:generate": "tsx scripts/generate-capability-matrix.ts",
    "capabilities:check": "tsx scripts/generate-capability-matrix.ts --check",
    "docs:continuity-check": "node scripts/sanitize-schema-doc.mjs --self-test && node scripts/check-doc-continuity.mjs && npm run capabilities:check",
    "prepare": "husky",
    "setup": "tsx setup/index.ts",
    "auth": "tsx src/whatsapp-auth.ts",
    "gmail:auth": "tsx src/gmail-consent.ts",
    "reauth": "bash reauth.sh",
    "test": "vitest run",
    "test:email-critical": "node scripts/run-email-critical-tests.mjs",
    "test:email-replay": "vitest run src/email-delivery-incident-replay.test.ts --pool=forks --no-file-parallelism --maxWorkers=1",
    "email:transport-canary": "node dist/email-transport-canary.js",
    "company-work:exceptions": "node dist/company-work-report-cli.js",
    "company-job-work:project": "node dist/company-job-work-shadow-cli.js",
    "company-gmail:coverage": "node dist/gmail-historical-coverage-cli.js",
    "test:watch": "vitest",
    "release:build": "node scripts/build-release.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "release:activate": "node scripts/activate-release.mjs"
  },
  "dependencies": {
    "@slack/bolt": "^4.6.0",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "better-sqlite3": "^11.8.1",
    "cron-parser": "^5.5.0",
    "cronstrue": "^3.14.0",
    "firebase-admin": "^13.8.0",
    "google-auth-library": "^10.6.1",
    "googleapis": "^171.4.0",
    "pg": "^8.20.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "playwright-core": "^1.62.1",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.0.18",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": "22.23.2"
  }
}
