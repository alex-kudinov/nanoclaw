{
  "name": "nanoclaw",
  "version": "1.2.1",
  "description": "Personal Claude assistant. Lightweight, secure, customizable.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "./scripts/with-pinned-node.sh tsc -p tsconfig.build.json",
    "start": "NODE_ENV=production NANOCLAW_REQUIRE_RELEASE_MANIFEST=1 ./scripts/with-pinned-node.sh node dist/index.js",
    "dev": "./scripts/with-pinned-node.sh tsx src/index.ts",
    "typecheck": "./scripts/with-pinned-node.sh tsc --noEmit",
    "format": "./scripts/with-pinned-node.sh prettier --write \"src/**/*.ts\"",
    "format:fix": "./scripts/with-pinned-node.sh prettier --write \"src/**/*.ts\"",
    "format:check": "./scripts/with-pinned-node.sh prettier --check \"src/**/*.ts\"",
    "capabilities:generate": "./scripts/with-pinned-node.sh tsx scripts/generate-capability-matrix.ts",
    "capabilities:check": "./scripts/with-pinned-node.sh tsx scripts/generate-capability-matrix.ts --check",
    "docs:continuity-check": "./scripts/with-pinned-node.sh node scripts/sanitize-schema-doc.mjs --self-test && ./scripts/with-pinned-node.sh node scripts/check-doc-continuity.mjs && ./scripts/with-pinned-node.sh npm run capabilities:check",
    "runtime:doctor": "./scripts/with-pinned-node.sh node scripts/runtime-doctor.mjs",
    "prepare": "./scripts/with-pinned-node.sh husky",
    "setup": "./scripts/with-pinned-node.sh tsx setup/index.ts",
    "auth": "./scripts/with-pinned-node.sh tsx src/whatsapp-auth.ts",
    "gmail:auth": "./scripts/with-pinned-node.sh tsx src/gmail-consent.ts",
    "reauth": "bash reauth.sh",
    "test": "./scripts/with-pinned-node.sh vitest run",
    "test:email-critical": "./scripts/with-pinned-node.sh node scripts/run-email-critical-tests.mjs",
    "test:email-replay": "./scripts/with-pinned-node.sh vitest run src/email-delivery-incident-replay.test.ts --pool=forks --no-file-parallelism --maxWorkers=1",
    "email:transport-canary": "./scripts/with-pinned-node.sh node dist/email-transport-canary.js",
    "company-work:exceptions": "./scripts/with-pinned-node.sh node dist/company-work-report-cli.js",
    "company-work:indicators": "./scripts/with-pinned-node.sh node dist/company-work-indicators-cli.js",
    "company-work:assess-outcome": "./scripts/with-pinned-node.sh node dist/company-work-outcome-quality-assessment-cli.js",
    "company-job-work:project": "./scripts/with-pinned-node.sh node dist/company-job-work-shadow-cli.js",
    "company-followup:shadow": "./scripts/with-pinned-node.sh node dist/followup-shadow-cli.js",
    "company-followup:review": "./scripts/with-pinned-node.sh node dist/followup-review-cli.js",
    "company-program-facts:run": "./scripts/with-pinned-node.sh node dist/program-facts-drift-job.js",
    "healer:resolution-catalog": "./scripts/with-pinned-node.sh node dist/healer/resolution-catalog-cli.js",
    "healer:company-work-plan": "./scripts/with-pinned-node.sh node dist/healer/company-work-projection-cli.js",
    "checkout-recovery:report": "./scripts/with-pinned-node.sh node dist/checkout-recovery-report-cli.js",
    "company-gmail:coverage": "./scripts/with-pinned-node.sh node dist/gmail-historical-coverage-cli.js",
    "company-gmail:bootstrap": "./scripts/with-pinned-node.sh node dist/company-gmail-source-bootstrap-cli.js",
    "company-gmail:audit": "./scripts/with-pinned-node.sh node dist/company-gmail-mailbox-audit-cli.js",
    "company-gmail:align-runtime": "./scripts/with-pinned-node.sh node dist/company-gmail-runtime-alignment-cli.js",
    "student-lifecycle:shadow-catalog": "./scripts/with-pinned-node.sh node dist/student-lifecycle-shadow-cli.js",
    "student-lifecycle:registry": "./scripts/with-pinned-node.sh node dist/student-lifecycle-provider-registry-cli.js",
    "student-lifecycle:reconcile": "./scripts/with-pinned-node.sh node dist/student-lifecycle-reconciliation-cli.js",
    "test:watch": "./scripts/with-pinned-node.sh vitest",
    "release:build": "./scripts/with-pinned-node.sh node scripts/build-release.mjs",
    "release:verify": "./scripts/with-pinned-node.sh node scripts/verify-release.mjs",
    "release:activate": "./scripts/with-pinned-node.sh node scripts/activate-release.mjs"
  },
  "dependencies": {
    "@slack/bolt": "^4.6.0",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "better-sqlite3": "^11.8.1",
    "cron-parser": "^5.5.0",
    "cronstrue": "^3.14.0",
    "firebase-admin": "^13.8.0",
    "google-auth-library": "^10.6.1",
    "googleapis": "^171.4.0",
    "pg": "^8.20.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "playwright-core": "^1.62.1",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.0.18",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": "22.23.2"
  }
}
