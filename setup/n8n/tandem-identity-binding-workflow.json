        "jsCode": "const envelope = $input.first().json || {};\nconst headers = envelope.headers && typeof envelope.headers === 'object'\n  ? envelope.headers\n  : {};\nconst readHeader = (name) => {\n  const entry = Object.entries(headers).find(\n    ([key]) => key.toLowerCase() === name,\n  );\n  return entry ? String(entry[1]) : '';\n};\nconst contentLength = readHeader('content-length');\nconst transferEncoding = readHeader('transfer-encoding');\nconst contentType = readHeader('content-type').split(';', 1)[0].trim().toLowerCase();\nconst reject = (statusCode, error) => [{\n  json: { route: 'reject', statusCode, responseBody: { error } },\n}];\nif (transferEncoding || !contentLength) {\n  return reject(411, 'content_length_required');\n}\nif (!/^(0|[1-9][0-9]*)$/.test(contentLength)) {\n  return reject(400, 'content_length_invalid');\n}\nconst declaredBytes = Number(contentLength);\nif (!Number.isSafeInteger(declaredBytes) || declaredBytes > 4096) {\n  return reject(413, 'request_too_large');\n}\nif (contentType !== 'application/json') {\n  return reject(415, 'json_required');\n}\nconst body = envelope.body;\nlet serialized;\ntry {\n  serialized = JSON.stringify(body);\n} catch {\n  return reject(400, 'json_invalid');\n}\nif (typeof serialized !== 'string') {\n  return reject(400, 'json_invalid');\n}\nif (Buffer.byteLength(serialized, 'utf8') > 4096) {\n  return reject(413, 'request_too_large');\n}\nreturn [{\n  json: {\n    route: 'forward',\n    authorization: readHeader('authorization'),\n    body,\n  },\n}];"
